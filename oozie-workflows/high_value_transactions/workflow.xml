<workflow-app xmlns="uri:oozie:workflow:0.5" name="high-value-transactions">
    <start to="hive-action"/>
    <action name="hive-action">
        <hive xmlns="uri:oozie:hive-action:0.5">
            <job-tracker>${jobTracker}</job-tracker>
            <name-node>${nameNode}</name-node>
            <script>/user/hadoop/workflow.hql</script>
        </hive>
        <ok to="end"/>
        <error to="fail"/>
    </action>
    <kill name="fail">
        <message>Workflow failed!</message>
    </kill>
    <end name="end"/>
</workflow-app>
